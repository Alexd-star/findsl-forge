{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://findsl-forge.local/schemas/financial-rules-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_id": {"type": "string", "minLength": 1},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "category", "source_role", "config_pointer", "applies_to", "preconditions", "semantic_invariant", "fallback_code", "fallback_behavior", "version"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^FR-[A-Z]+-[0-9]{3}$"},
          "category": {"enum": ["adjustment", "data_mapping", "scope_membership", "ranking", "temporal", "optimization"]},
          "source_role": {"type": "string", "minLength": 1},
          "config_pointer": {"type": "string", "pattern": "^/"},
          "applies_to": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "preconditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "semantic_invariant": {"type": "string", "minLength": 1},
          "fallback_code": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "fallback_behavior": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
