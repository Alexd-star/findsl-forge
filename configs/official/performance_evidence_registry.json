      "source": "reports/official_compile_latency.json",
      "value_path": "p95_ms",
      "unit": "ms",
      "comparator": "lt",
      "threshold": 50.0,
      "score_gate": true,
      "claim": "用于赛题正式编译P95低于50毫秒门禁"
    },
    {
      "metric_id": "hero_query_execution",
      "workload": "then、CONS、EXIST、跨市场集合运算和分阶段排名复合Hero Query",
      "dataset": "官方A股日频数据与人工冻结Reference SQL",
      "source": "reports/hero_query.json",
      "value_path": "execution.generated_elapsed_ms",
      "unit": "ms",
      "comparator": "lte",
      "threshold": 10000.0,
      "score_gate": false,
      "claim": "证明高复杂度组合问句在真实Doris上的完整结果等价和现场可执行性"
