{
  "schema_version": 2,
  "registry_id": "official-performance-evidence-taxonomy-v2",
  "metrics": [
    {
      "metric_id": "official_routine_prefix_speedup",
      "workload": "官方真实行情常规20日成交量窗口：窗口基线与前缀表路径",
      "dataset": "官方A股日频数据，13,650,347行",
      "source": "reports/official_doris_evidence.json",
      "value_path": "baseline_vs_prefix_speedup",
      "unit": "x",
      "comparator": "gte",
      "threshold": 1.0,
      "score_gate": false,
      "claim": "证明常规窗口工作负载的前缀路径没有性能退化，不代表全部查询的加速倍数"
    },
    {
      "metric_id": "official_long_horizon_min_speedup",
