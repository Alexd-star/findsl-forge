      "dataset": "官方A股日频数据，覆盖2006-01-04至2026-04-14",
      "source": "reports/official_long_horizon_matrix.json",
      "value_path": "minimum_speedup",
      "unit": "x",
      "comparator": "gte",
      "threshold": 10.0,
      "score_gate": true,
      "claim": "用于赛题长周期查询相对全表扫描不低于10倍的保守门禁，取五类工作负载中的最小值"
    },
    {
      "metric_id": "synthetic_5m_scalability_speedup",
      "workload": "500万行确定性合成数据的120日滑窗与前缀路径",
      "dataset": "合成可复现扩展性数据，不是官方语料",
      "source": "reports/doris_cluster_evidence.json",
      "value_path": "speedup",
      "unit": "x",
      "comparator": "gte",
      "threshold": 1.0,
      "score_gate": false,
      "claim": "证明扩展性实验中的优化潜力，不替代官方真实数据门禁"
    },
    {
      "metric_id": "official_full_matrix_max_p95",
      "workload": "覆盖12类官方函数族和主要物理计划的48条分层Doris执行矩阵",
      "dataset": "官方A股日频数据与独立Reference SQL",
      "source": "reports/official_full_performance_matrix.json",
      "value_path": "max_p95_ms",
      "unit": "ms",
      "comparator": "lte",
      "threshold": 10000.0,
      "score_gate": true,
      "claim": "用于赛题SQL执行时间不超过10秒的分层工作负载门禁"
    },
    {
      "metric_id": "official_compile_p95",
      "workload": "48条分层官方有效问句的正式编译器预热服务请求",
