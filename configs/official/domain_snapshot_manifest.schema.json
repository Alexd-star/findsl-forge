{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider_id", "domain_id", "profile_id", "snapshot_id", "source_uri", "retrieved_at", "as_of_date", "content_sha256", "row_count", "columns", "temporal_model", "license_accepted"],
  "properties": {
    "schema_version": {"const": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "domain_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "profile_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "source_uri": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "as_of_date": {"type": "string", "format": "date"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "row_count": {"type": "integer", "minimum": 1},
    "columns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "temporal_model": {"enum": ["effective_dated", "dated_snapshot", "current_snapshot", "historical_series", "project_policy"]},
    "license_accepted": {"type": "boolean"}
  }
}
