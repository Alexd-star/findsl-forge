{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://findsl-forge.local/schemas/official-functions-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "functions"],
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["arg"],
          "properties": {"arg": {"type": "integer", "minimum": 0, "maximum": 7}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["literal"],
          "properties": {"literal": {"type": ["boolean", "number", "string"]}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "args"],
          "properties": {
            "op": {
              "enum": [
                "abs", "negate", "not", "add", "subtract", "multiply",
                "safe_divide", "greatest", "greater_than", "greater_equal",
                "less_than", "less_equal", "equal", "not_equal", "and", "or",
                "coalesce"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {"$ref": "#/$defs/expression"}
            }
          }
        }
      ]
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "aliases", "argument_mode", "arg_types", "result_kind", "expression_template", "version"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "aliases": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}, "uniqueItems": true},
          "argument_mode": {"const": "expressions"},
          "arg_types": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"enum": ["numeric", "boolean", "string"]}},
          "result_kind": {"enum": ["numeric", "boolean", "string"]},
          "expression_template": {"$ref": "#/$defs/expression"},
          "version": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
