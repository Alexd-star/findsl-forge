{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domains"],
  "properties": {
    "schema_version": {"const": 1},
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain_id", "indicator_domains", "provider_domain_ids", "description", "granularity", "temporal_model", "primary_keys", "quality_gates", "profiles"],
        "properties": {
          "domain_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "indicator_domains": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "provider_domain_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "description": {"type": "string", "minLength": 1},
          "granularity": {"enum": ["static", "event", "reporting_period", "daily", "intraday", "mixed"]},
          "temporal_model": {"enum": ["timeless", "historical_series", "effective_dated", "dated_snapshot", "current_snapshot", "request_scoped", "derived"]},
          "primary_keys": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "quality_gates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "profiles": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["profile_id", "status", "active_provider_ids", "candidate_provider_ids", "reason"],
              "properties": {
                "profile_id": {"type": "string", "minLength": 1},
                "status": {"enum": ["available", "derived", "not_loaded", "unsupported", "private_required"]},
                "active_provider_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
                "candidate_provider_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
                "reason": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
