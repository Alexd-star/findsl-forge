{"name": "未知指标名", "dsl": "filter(indicator(\"clos\") > 10)", "expected_code": "UNKNOWN_INDICATOR", "expected_suggestion_fragments": ["indicator(\"close\")"]}
{"name": "未知函数", "dsl": "filter(UNKNOWN(indicator(\"close\")))", "expected_code": "UNKNOWN_FUNCTION", "expected_suggestion_fragments": ["configs/functions.json"]}
{"name": "CONS参数类型错误", "dsl": "filter(CONS(indicator(\"close\"), 3))", "expected_code": "SEMANTIC_ERROR", "expected_suggestion_fragments": ["Wrap numeric expressions in comparisons"]}
{"name": "窗口必须为正数", "dsl": "filter(indicator(\"close\") > MA(indicator(\"close\"), 0))", "expected_code": "SEMANTIC_ERROR", "expected_suggestion_fragments": ["positive integer window"]}
{"name": "缺少右括号", "dsl": "filter(indicator(\"close\") > MA(indicator(\"close\"), 20)", "expected_code": "PARSE_ERROR", "expected_suggestion_fragments": ["missing closing parenthesis"]}
{"name": "字符串未闭合", "dsl": "filter(indicator(\"close) > 10)", "expected_code": "LEX_ERROR", "expected_suggestion_fragments": ["missing closing double quote"]}
{"name": "rank命名参数错误", "dsl": "rank(indicator(\"close\"), desc, limit=10)", "expected_code": "SEMANTIC_ERROR", "expected_suggestion_fragments": ["supported named args"]}
{"name": "rank百分比越界", "dsl": "rank(indicator(\"close\"), desc, percent=120)", "expected_code": "SEMANTIC_ERROR", "expected_suggestion_fragments": ["0 < N <= 100"]}
{"name": "rank底部排序方向不一致", "dsl": "rank(indicator(\"close\"), desc, bottom=2)", "expected_code": "SEMANTIC_ERROR", "expected_suggestion_fragments": ["rank(..., asc, bottom=N)"]}
{"name": "日期区间起止倒置", "dsl": "filter(date_between(\"2026-01-04\", \"2026-01-02\"))", "expected_code": "SEMANTIC_ERROR", "expected_suggestion_fragments": ["YYYY-MM-DD"]}
{"name": "数字字面量格式错误", "dsl": "filter(indicator(\"close\") > 1.2.3)", "expected_code": "LEX_ERROR", "expected_suggestion_fragments": ["numeric literals"]}
{"name": "裸指标列名绕过", "dsl": "close > 10", "expected_code": "SEMANTIC_ERROR", "expected_suggestion_fragments": ["indicator(\"close\")"]}
{"name": "filter条件不是布尔表达式", "dsl": "filter(indicator(\"close\"))", "expected_code": "SEMANTIC_ERROR", "expected_suggestion_fragments": ["filter() expects a boolean condition"]}
